# NeuroChiro Production Environment Variables
# Copy this to .env.local and fill in real values

# === REQUIRED ===

# Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe (Payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_MONTHLY_PRICE_ID="price_..."
STRIPE_STARTER_ANNUAL_PRICE_ID="price_..."
STRIPE_GROWTH_MONTHLY_PRICE_ID="price_..."
STRIPE_GROWTH_ANNUAL_PRICE_ID="price_..."
STRIPE_PRO_MONTHLY_PRICE_ID="price_..."
STRIPE_PRO_ANNUAL_PRICE_ID="price_..."

# Anthropic (AI Bio Generator + Contract Lab)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (Emails)
RESEND_API_KEY="re_..."

# Site URL
NEXT_PUBLIC_SITE_URL="https://neurochiro.co"

# Founder Access (comma-separated emails)
NEXT_PUBLIC_FOUNDER_EMAILS="drray@neurochirodirectory.com,raymond@neurochiro.com"

# Cron Job Security (generate with: openssl rand -hex 32)
CRON_SECRET="your-random-secret-here"

# === REQUIRED FOR FEATURES ===

# Mapbox (Directory Map)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1..."

# Discord (Admin Alerts)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# === OPTIONAL ===

# Twilio (SMS notifications — app works without these)
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_PHONE="+1..."

# Google Places (Doctor profile reviews — shows empty state without this)
# GOOGLE_PLACES_API_KEY="AIza..."

# Instant lead texts (Quo). Off unless SMS_ENABLED is exactly true.
# QUO_API_KEY is a secret. Add it in Vercel. Do not commit a real key.
SMS_ENABLED=false
QUO_API_KEY=
QUO_FROM_NUMBER=+18647547495
SMS_TEST_PHONE=
QUO_API_BASE=

# Doctor application + approval.
# Leave this unset until the SQL file has been run:
# supabase/migrations/proposed/20261104120000_doctor_applications.sql
# Set it to exactly true to turn the new flow on. Any other value keeps today's signup.
APPLICATION_FLOW_ENABLED=false

# Reminders for unfinished doctor applications. Email goes out from the cron.
# Texts stay off until carrier registration for this message is confirmed.
# Set this to exactly true to also text applicants who agreed and gave a US or Canadian mobile number.
APPLICATION_REMINDER_SMS_ENABLED=false

# Stripe Price IDs for the doctor membership. Copy each one from the existing
# Payment Link in the Stripe Dashboard (open the link, then the price).
# Do not create new products or prices.
# USD is $99 per month and $990 per year, per office.
# CAD, AUD, GBP, NZD, EUR, and AED are the founding prices already on those links.
STRIPE_DOCTOR_PRICE_USD_MONTHLY=
STRIPE_DOCTOR_PRICE_USD_ANNUAL=
STRIPE_DOCTOR_PRICE_CAD_MONTHLY=
STRIPE_DOCTOR_PRICE_CAD_ANNUAL=
STRIPE_DOCTOR_PRICE_AUD_MONTHLY=
STRIPE_DOCTOR_PRICE_AUD_ANNUAL=
STRIPE_DOCTOR_PRICE_GBP_MONTHLY=
STRIPE_DOCTOR_PRICE_GBP_ANNUAL=
STRIPE_DOCTOR_PRICE_NZD_MONTHLY=
STRIPE_DOCTOR_PRICE_NZD_ANNUAL=
STRIPE_DOCTOR_PRICE_EUR_MONTHLY=
STRIPE_DOCTOR_PRICE_EUR_ANNUAL=
STRIPE_DOCTOR_PRICE_AED_MONTHLY=
STRIPE_DOCTOR_PRICE_AED_ANNUAL=

# Optional MRR currency table. Values are foreign units per 1 USD.
# When unset, the admin MRR card fetches a daily rate and falls back to 13 Nov 2026.
# MRR_FX_RATES={"date":"2026-11-13","CAD":1.42563,"AUD":1.468309,"GBP":0.755149}
